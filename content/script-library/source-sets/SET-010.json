  "scripts": [
    {
      "script_id": "SET-010-ORIGINAL",
      "script_version": "ORIGINAL",
      "status": "Ready",
      "hook_type": "ORIGINAL",
      "format": "listicle",
      "original_slide_count": 10,
      "final_slide_count": 10,
      "slides": [
        {
          "slide_number": 1,
          "slide_label": "Slide 1",
          "is_metafi_slide": false,
          "text": "هذا كل اللي تحتاجينه\nعشان تفتحين نيل سبا بالسعودية\nتمنيت أحد علمني"
        },
        {
          "slide_number": 2,
          "slide_label": "Slide 2",
          "is_metafi_slide": false,
          "text": "احفظي المقطع\nبتحتاجينه"
        },
        {
          "slide_number": 3,
          "slide_label": "Slide 3",
          "is_metafi_slide": false,
          "text": "أول شي\nمشروع النيل سبا مو كراسي وديكور\nهو تشغيل وأوراق وعمالة وفواتير"
        },
        {
          "slide_number": 4,
          "slide_label": "Slide 4",
          "is_metafi_slide": false,
          "text": "ثاني نقطة\nلا تثقلين على نفسك بإيجار كبير\nكثير فتحوا بمحلات كبيرة\nوبعد كم شهر صاروا يعانون من المصاريف"
        },
        {
          "slide_number": 5,
          "slide_label": "Slide 5",
          "is_metafi_slide": false,
          "text": "اختيار العمالة\nالفنيات هم أساس الشغل\nلا تعتمدين على فنية وحدة\nإذا غابت أو تأخرت\nيتلخبط جدولك كله"
        },
        {
          "slide_number": 6,
          "slide_label": "Slide 6",
          "is_metafi_slide": false,
          "text": "المواد\nجل وقفازات ومناشف ومزيل وأدوات\nهذي تستهلك ميزانية كبيرة كل شهر"
        },
        {
          "slide_number": 7,
          "slide_label": "Slide 7",
          "is_metafi_slide": false,
          "text": "خامس نقطة\nالتجربة\nالعميلة ما ترجع بس عشان الشغل\nترجع لإحساسها بالمكان"
        },
        {
          "slide_number": 8,
          "slide_label": "Slide 8",
          "is_metafi_slide": false,
          "text": "سادس نقطة\nالتسويق\nلا تعتمدين على الناس يجون لحالهم\nالسوق مليان\nلازم صور صادقة وشغل نظيف\nوسعر واضح وحجز سريع"
        },
        {
          "slide_number": 9,
          "slide_label": "Slide 9",
          "is_metafi_slide": false,
          "text": "آخر نقطة\nالسمعة أهم من أي إعلان\nإذا عجبتها الخدمة بتجيب صديقاتها\nوكلمة وحدة ترفع دخلك أو تخسره"
        },
        {
          "slide_number": 10,
          "slide_label": "Slide 10",
          "is_metafi_slide": true,
          "text": "الاهم من كذا تعرفين اسرار المشروع وطريقة البدء "
        }
      ]
    }
  ]
}
